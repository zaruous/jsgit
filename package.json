{
  "name": "jsgit",
  "version": "0.1.0",
  "private": true,
  "description": "jsgit - exbe·jabe 공용 git 라이브러리 (isomorphic-git 서버 서비스 + HTTP 처리기 + 브라우저 클라이언트·UI 로직)",
  "repository": { "type": "git", "url": "git+https://github.com/zaruous/jsgit.git" },
  "type": "module",
  "exports": {
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./codemirror": "./src/codemirror/index.ts",
    "./types": "./src/types.ts",
    "./version": "./src/version.ts"
  },
  "files": ["src", "!src/**/*.test.ts", "!src/server/test-http-server.ts"],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "isomorphic-git": "1.44.8"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": { "optional": true },
    "@codemirror/view": { "optional": true }
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
