# Normalize line endings: store as LF in the repo, check out as LF on all platforms
* text=auto eol=lf

# Binary files: never normalize
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary

# compiler fixtures: keep CRLF as generated by the original compiler (exact comparison)
src/compiler/__fixtures__/** -text
